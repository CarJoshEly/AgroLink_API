{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^sanitize-html$": "<rootDir>/src/test/mocks/sanitize-html.mock.ts"
  },
  "testTimeout": 30000
}
