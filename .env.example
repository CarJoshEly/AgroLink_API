# ==========================================================================
# AgroLink API — Ejemplo de Variables de Entorno (.env.example)
# ==========================================================================

NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Base de Datos (Prisma / PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrolink_db?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/agrolink_db?schema=public

# JWT Autenticación
JWT_SECRET=tu_jwt_secret_aqui
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Pasarela de Pagos (PayPal Sandbox)
PAYPAL_CLIENT_ID=tu_client_id_sandbox
PAYPAL_SECRET=tu_secret_sandbox
PAYPAL_MODE=sandbox
