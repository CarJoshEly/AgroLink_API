# ==========================================================================
# AgroLink Honduras — API_REST — Variables de entorno
# ==========================================================================
# Copiar a `.env` (nunca versionado) y llenar con valores reales. Para el
# deploy en Render, estas mismas claves (salvo las que ya tienen `value` fijo)
# se cargan a mano en el dashboard del servicio — ver render.yaml.

# ─── Aplicación ────────────────────────────────────────────────────────
NODE_ENV=development
# production activa: gate de Swagger (se apaga), CORS fail-closed sin
# CORS_ORIGINS, y oculta los devToken de verificación/reset en las
# respuestas de /auth/*.
PORT=3000
API_PREFIX=api
API_VERSION=v1

# ─── Base de datos (Supabase PostgreSQL) ──────────────────────────────
# DATABASE_URL: conexión pooled (PgBouncer) — la usa la app en runtime.
# DIRECT_URL: conexión directa — la necesita `prisma migrate deploy` (el
# pooler no soporta los prepared statements que usan las migraciones).
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=public"

# ─── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── CORS ───────────────────────────────────────────────────────────────
# Orígenes separados por coma, cada uno con esquema y sin `/` al final
# (p.ej. https://agrolink.hn, no agrolink.hn/ ). Vacío en producción =
# rechaza todo cross-origin (fail-closed) — no cae a "*".
CORS_ORIGINS=http://localhost:3001

# Dominio del frontend web al que apuntan los links de los correos
# (verificación de cuenta, restablecer contraseña, aviso de nueva
# verificación de vendedor al admin).
WEB_APP_URL=http://localhost:3001

# ─── Rate limiting (global, @nestjs/throttler) ────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Supabase Storage (fotos de producto, documentos de verificación) ─
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# ─── Correo saliente (API de Brevo, brevo.com) ────────────────────────
# SMTP directo hacia Gmail resultó poco confiable desde Render (bloqueos
# y timeouts intermitentes) — se manda por la API HTTPS de Brevo en su
# lugar. Generarla en brevo.com -> SMTP & API -> API Keys. El remitente
# (`MAIL_FROM_ADDRESS`) debe estar verificado ahí -> Senders.
BREVO_API_KEY=
MAIL_FROM_ADDRESS="AgroLink Honduras <agrolink.hn@gmail.com>"
# Bandeja donde el equipo revisa solicitudes de verificación de vendedor
ADMIN_NOTIFY_EMAIL=agrolink.hn@gmail.com

# ─── Google Maps (geocoding / distancia entre comprador y vendedor) ──
GOOGLE_MAPS_API_KEY=

# ─── Google Sign-In (comprador) ────────────────────────────────────────
# El "Web application" OAuth 2.0 Client ID de Google Cloud Console. Se usa
# como `audience` al verificar el idToken (web y móvil) y también como
# `serverClientId` en el google_sign_in de la app móvil — por eso un solo
# Client ID basta para ambas plataformas. No es secreto (va en el frontend).
GOOGLE_CLIENT_ID=

# ─── Pasarela de pagos (PayPal) ──
# Client ID + Secret de tu app sandbox en developer.paypal.com ->
# "My Apps & Credentials" -> "Sandbox". Sin credenciales reales (o con estos
# placeholders) el backend responde 503 en /payments/paypal/* en vez de
# fallar en silencio.
PAYPAL_CLIENT_ID=tu_client_id_sandbox
PAYPAL_SECRET=tu_secret_sandbox
PAYPAL_MODE=sandbox
# Tasa fija HNL -> USD para convertir el total del carrito (PayPal no cobra
# en Lempiras). Ajustar si el tipo de cambio cambia mucho.
PAYPAL_HNL_TO_USD_RATE=24.70

# URL pública de ESTE backend (no la del frontend web) — PayPal la usa como
# return_url/cancel_url del checkout redirigido que abre el WebView de la
# app móvil. En local no hace falta tocarla; en Render debe ser la URL real
# del servicio (https://agrolink-api-we44.onrender.com).
API_PUBLIC_URL=http://localhost:3000
