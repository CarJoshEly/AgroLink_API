# ==========================================================================
# AgroLink Honduras Marketplace — Environment Variables
# ==========================================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# JWT (preparado para Sprint de Auth)
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Supabase Storage (usar el secret/service_role key — no el publishable, que es RLS-restringido)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# Google Maps (Geocoding API)
GOOGLE_MAPS_API_KEY=
