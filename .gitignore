# de Render) lo necesita para instalar versiones reproducibles.

# Build
dist/
build/

# Variables de entorno
.env
.env.local
.env.production

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Tests
coverage/
.nyc_output/

# Temporal
tmp/
temp/
