// ==========================================================================
// AgroLink Honduras Marketplace — Prisma Schema (Fase 2: Diseño de Base de Datos)
// PostgreSQL + Prisma ORM
// ==========================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------------------------
// ENUMS
// --------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SELLER
  CUSTOMER
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  INACTIVE
}

enum ProductUnit {
  UNIT
  LB
  KG
  QQ // quintal
  ARROBA
  MANOJO
  BOX
  BAG
  LITER
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELLED
}

enum ReviewModerationStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
}

enum ReportTargetType {
  PRODUCT
  SELLER
  REVIEW
  PRODUCT_REVIEW
  SELLER_REVIEW
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  NEW_ORDER
  ORDER_ACCEPTED
  ORDER_CANCELLED
  ORDER_PREPARING
  ORDER_DELIVERED
  SELLER_APPROVED
  SELLER_REJECTED
  SELLER_SUSPENDED
  NEW_REVIEW
  REPORT_RECEIVED
  PAYMENT_UPDATE
}

/// A qué entidad navegar al tocar una notificación (deep link). Opcional a
/// propósito — no todas las notificaciones tienen un destino navegable
/// (p. ej. SELLER_APPROVED lleva a "mi verificación", que no necesita ID).
enum NotificationTargetType {
  ORDER
  PRODUCT
  SELLER
}

enum PaymentProvider {
  PAYPAL
  CREDIT_CARD
  DEBIT_CARD
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

// --------------------------------------------------------------------------
// CATÁLOGOS GEOGRÁFICOS (Honduras)
// --------------------------------------------------------------------------

model Department {
  id            String         @id @default(uuid())
  name          String         @unique
  code          String         @unique
  municipalities Municipality[]
  locations     Location[]
  createdAt     DateTime       @default(now())

  @@map("departments")
}

model Municipality {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  locations    Location[]
  createdAt    DateTime   @default(now())

  @@index([departmentId])
  @@map("municipalities")
}

model Location {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  municipalityId String
  municipality   Municipality  @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  address        String
  latitude       Decimal       @db.Decimal(9, 6)
  longitude      Decimal       @db.Decimal(9, 6)
  isPrimary      Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([departmentId, municipalityId])
  @@map("locations")
}

// --------------------------------------------------------------------------
// USUARIOS E IDENTIDAD
// --------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  avatarUrl    String?
  // Nulo para cuentas creadas por "Continuar con Google" que nunca
  // establecieron una contraseña propia (pueden hacerlo después vía
  // "Olvidé mi contraseña", que sí les asigna una).
  passwordHash String?
  // `sub` de Google — solo lo tienen las cuentas que iniciaron sesión (o se
  // vincularon) con Google. Único porque un `sub` de Google identifica una
  // sola cuenta real, nunca debería repetirse entre dos usuarios nuestros.
  googleId     String?    @unique
  role         UserRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  emailVerifiedAt            DateTime?
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?
  passwordResetToken         String?   @unique
  passwordResetExpiresAt     DateTime?

  sellerProfile SellerProfile?
  locations     Location[]
  carts         Cart[]
  favorites     Favorite[]
  ordersAsBuyer Order[]        @relation("BuyerOrders")
  productReviews ProductReview[]
  sellerReviews  SellerReview[]
  reports       Report[]       @relation("ReporterReports")
  notifications Notification[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  inventoryMovements InventoryMovement[]
  orderStatusChanges OrderStatusHistory[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model SellerProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessName       String
  dni                String              @unique
  verificationStatus VerificationStatus  @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?
  suspendedReason    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  identityVerification IdentityVerification?
  products             Product[]
  ordersAsSeller       Order[]               @relation("SellerOrders")
  reviews              SellerReview[]
  favoritedBy          Favorite[]

  @@index([verificationStatus])
  @@map("seller_profiles")
}

model IdentityVerification {
  id              String             @id @default(uuid())
  sellerProfileId String             @unique
  sellerProfile   SellerProfile      @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  dniFrontUrl     String
  dniBackUrl      String
  selfieUrl       String
  lifeProofUrl    String
  status          VerificationStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  notes           String?
  createdAt       DateTime           @default(now())

  @@map("identity_verifications")
}

// --------------------------------------------------------------------------
// CATÁLOGO Y PRODUCTOS
// --------------------------------------------------------------------------

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  isActive Boolean    @default(true)
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id           String        @id @default(uuid())
  sellerId     String
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name         String
  description  String
  price        Decimal       @db.Decimal(10, 2)
  unit         ProductUnit
  stock        Int           @default(0)
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  images             ProductImage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  favorites          Favorite[]
  reviews            ProductReview[]
  inventoryMovements InventoryMovement[]

  @@index([sellerId])
  @@index([categoryId, status])
  @@map("products")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  productId     String
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  type          InventoryMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  createdBy     String
  user          User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// --------------------------------------------------------------------------
// CARRITO Y FAVORITOS
// --------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items CartItem[]

  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Favorite {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  String?
  seller    SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, productId])
  @@unique([userId, sellerId])
  @@index([userId])
  @@index([productId])
  @@index([sellerId])
  @@map("favorites")
}

// --------------------------------------------------------------------------
// PEDIDOS (SOLICITUD DE COMPRA)
// --------------------------------------------------------------------------

model Order {
  id           String        @id @default(uuid())
  buyerId      String
  buyer        User          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId     String
  seller       SellerProfile @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  status       OrderStatus   @default(PENDING)
  totalAmount  Decimal       @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  confirmedAt  DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?

  items          OrderItem[]
  productReviews ProductReview[]
  sellerReview   SellerReview?
  transaction    Transaction?
  statusHistory  OrderStatusHistory[]

  @@index([buyerId])
  @@index([sellerId, status])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String
  user       User         @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  review ProductReview?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// --------------------------------------------------------------------------
// REVIEWS Y REPUTACIÓN
// --------------------------------------------------------------------------

model ProductReview {
  id               String                 @id @default(uuid())
  orderId          String
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId      String                 @unique
  orderItem        OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productId        String
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyerId          String
  buyer            User                   @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  rating           Int
  comment          String?
  moderationStatus ReviewModerationStatus @default(PENDING_REVIEW)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  @@index([productId])
  @@index([buyerId])
  @@map("product_reviews")
}

model SellerReview {
  id                String                 @id @default(uuid())
  orderId           String                 @unique
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerId          String
  seller            SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  buyerId           String
  buyer             User                   @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  qualityScore      Int
  responseTimeScore Int
  complianceScore   Int
  attentionScore    Int
  trustScore        Int
  comment           String?
  moderationStatus  ReviewModerationStatus @default(PENDING_REVIEW)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?

  @@index([sellerId])
  @@index([buyerId])
  @@map("seller_reviews")
}

// --------------------------------------------------------------------------
// REPORTES
// --------------------------------------------------------------------------

model Report {
  id         String           @id @default(uuid())
  reporterId String
  reporter   User             @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Restrict)
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
  @@map("reports")
}

// --------------------------------------------------------------------------
// NOTIFICACIONES
// --------------------------------------------------------------------------

model Notification {
  id         String                  @id @default(uuid())
  userId     String
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  isRead     Boolean                 @default(false)
  targetType NotificationTargetType?
  targetId   String?
  createdAt  DateTime                @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// --------------------------------------------------------------------------
// PAGOS (PREPARACIÓN — SIN COBRO REAL EN EL MVP)
// --------------------------------------------------------------------------

model PaymentMethod {
  id        String          @id @default(uuid())
  name      String
  provider  PaymentProvider
  isActive  Boolean         @default(true)
  config    Json?
  createdAt DateTime        @default(now())

  transactions Transaction[]

  @@map("payment_methods")
}

model Transaction {
  id                  String            @id @default(uuid())
  orderId             String            @unique
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentMethodId     String
  paymentMethod       PaymentMethod     @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  amount              Decimal           @db.Decimal(10, 2)
  commissionAmount    Decimal           @db.Decimal(10, 2)
  commissionPercentage Decimal          @db.Decimal(5, 2)
  status              TransactionStatus @default(PENDING)
  externalReference   String?
  createdAt           DateTime          @default(now())
  completedAt         DateTime?

  @@index([paymentMethodId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model CommissionConfig {
  id             String    @id @default(uuid())
  percentage     Decimal   @db.Decimal(5, 2)
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)
  createdBy      String

  @@index([isActive, effectiveFrom])
  @@map("commission_configs")
}

// --------------------------------------------------------------------------
// AUDITORÍA
// --------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_configs")
}
